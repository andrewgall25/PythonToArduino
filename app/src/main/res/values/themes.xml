<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Colore dello sfondo della splash (es. bianco o il tuo blu) -->
        <item name="windowSplashScreenBackground">#162F72</item>

        <!-- L'icona da mostrare al centro -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/converted</item>

        <!-- Il tema da applicare subito dopo il caricamento -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.NoActionBar</item>
    </style>
</resources>